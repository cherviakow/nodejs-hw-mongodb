{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "Contact book",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "description": "Contact book app"
  },
  "servers": [
    {
      "url": "https://nodejs-hw-mongodb-1-xrz0.onrender.com"
    }
  ],
  "tags": [
    {
      "name": "Contacts",
      "description": "Operation about Contacts."
    },
    {
      "name": "Auth",
      "description": "Auth operation."
    }
  ],
  "paths": {
    "/contacts/{id}": {
      "get": {
        "tags": [
          "Contacts"
        ],
        "summary": "Get contact by id",
        "operationId": "getContact",
        "description": "Get contact by id",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string",
              "example": "65ca67e7ae7f10c88b598384"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Get contact by id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "message",
                    "data"
                  ],
                  "properties": {
                    "status": {
                      "type": "integer",
                      "example": 200
                    },
                    "message": {
                      "type": "string",
                      "example": "Successfully found contact with id 65ca67e7ae7f10c88b598384!"
                    },
                    "data": {
                      "type": "object",
                      "$ref": "#/components/schemas/contact"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "contact": {
        "type": "object",
        "required": [
          "_id",
          "name",
          "phoneNumber",
          "email",
          "contactType",
          "userId"
        ],
        "properties": null,
        "_id": {
          "description": "Contact id",
          "type": "string",
          "example": "672f0f184881d3e9b8604c99"
        },
        "name": {
          "description": "Contact name",
          "type": "string",
          "example": "John"
        },
        "phoneNumber": {
          "description": "Contact phone number",
          "type": "string",
          "example": 6131112233
        },
        "email": {
          "description": "Contact email",
          "type": "string",
          "example": "contact@gmail.com"
        },
        "contactType": {
          "description": "Contact type",
          "type": "string",
          "enum": [
            "work",
            "home",
            "personal"
          ],
          "example": "personal"
        },
        "userId": {
          "description": "Contact user id",
          "type": "string",
          "example": "672f0f184881d3e9b8604c99"
        },
        "photo": {
          "description": "Link to contact photo",
          "type": "string",
          "format": "binary",
          "example": "https://res.cloudinary.com/dldpn9cqd/image/upload/v1731660549/w5afx9vryxbezp0o5g8p.webp",
          "default": null
        }
      }
    }
  }
}